    "brand-subtle-pressed": { "$value": "{color.lapis.400}", "$extensions": { "mabda.alpha": 0.24 } },
    "brand-bold": { "$value": "{color.lapis.600}" },
    "brand-bold-hover": { "$value": "{color.lapis.700}" },
    "brand-bold-pressed": { "$value": "{color.lapis.800}" },
    "danger-subtle": { "$value": "{color.brick.400}", "$extensions": { "mabda.alpha": 0.16 } },
    "danger-subtle-hover": { "$value": "{color.brick.400}", "$extensions": { "mabda.alpha": 0.2 } },
    "danger-subtle-pressed": { "$value": "{color.brick.400}", "$extensions": { "mabda.alpha": 0.24 } },
    "danger-bold": { "$value": "{color.brick.600}" },
    "danger-bold-hover": { "$value": "{color.brick.700}" },
    "danger-bold-pressed": { "$value": "{color.brick.800}" },

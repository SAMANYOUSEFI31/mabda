{
  "$description": "Mabda semantic colours, dark mode. Names are roles, not hues; meaning in docs/ux/meaning-map.md. Every key here must exist in the other mode (src/ui/tokens.test.ts).",
  "surface": {
    "$type": "color",
    "page": { "$value": "{color.ink.950}" },
    "sunken": { "$value": "{color.ink.975}" },
    "raised": { "$value": "{color.ink.925}" },
    "overlay": { "$value": "{color.ink.900}" }
  },
  "bg": {
    "$type": "color",
    "neutral-subtle": { "$value": "{color.ink.25}", "$extensions": { "mabda.alpha": 0.07 } },
    "neutral-subtle-hover": { "$value": "{color.ink.25}", "$extensions": { "mabda.alpha": 0.1 } },
    "neutral-subtle-pressed": { "$value": "{color.ink.25}", "$extensions": { "mabda.alpha": 0.14 } },
    "neutral-bold": { "$value": "{color.ink.100}" },
    "neutral-bold-hover": { "$value": "{color.ink.200}" },
    "neutral-bold-pressed": { "$value": "{color.ink.300}" },

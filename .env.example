# --- Mabda AI -------------------------------------------------------------
# Default: users bring their own Gemini key (BYOK) from the app's AI settings.
#
# Managed AI (the product pays) is behind a feature flag and OFF by default.
# To enable it for development:
#   MABDA_MANAGED_AI=on
#   GEMINI_API_KEY="AIzaSy..."      # Google AI Studio key (free tier is enough for local work)
MABDA_MANAGED_AI=off
GEMINI_API_KEY=""

# Secret used to encrypt BYOK keys at rest (AES-256-GCM). If empty, a random one is
# generated once into server/data/secret.key. Set it explicitly in production.
MABDA_SECRET=""

# APP_URL: where the app is hosted (injected by AI Studio).
APP_URL="MY_APP_URL"

# Manager ledger (real cost per workspace vs plan price). Off by default.
MABDA_ADMIN=off

# Where the SQLite database lives (default: server/data/mabda.sqlite)
# MABDA_DB_PATH=

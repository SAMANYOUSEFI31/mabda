# Optional: دسترسی به ابزارها و گزارش‌های سطح مدیر
MABDA_ADMIN=

# Optional feature flag: فعال‌سازی هوش مصنوعی مدیریت‌شده پلتفرم (مقدار نمونه: false)
MABDA_MANAGED_AI=false

# Server-side secret: کلید Gemini API؛ فقط در صورت فعال‌بودن هوش مصنوعی مدیریت‌شده لازم است
GEMINI_API_KEY=

# Optional: مسیر سفارشی فایل دیتابیس SQLite
MABDA_DB_PATH=
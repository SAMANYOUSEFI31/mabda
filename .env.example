# Optional: دسترسی به ابزارها و گزارش‌های سطح مدیر
MABDA_ADMIN=

# Optional feature flag: فعال‌سازی هوش مصنوعی مدیریت‌شده پلتفرم (مقدار نمونه: false)
MABDA_MANAGED_AI=false

# Server-side secret: کلید Gemini API؛ فقط در صورت فعال‌بودن هوش مصنوعی مدیریت‌شده لازم است
GEMINI_API_KEY=

# Optional: مسیر سفارشی فایل دیتابیس SQLite
MABDA_DB_PATH=

# Optional (لایهٔ هوش): نشانی سرویس لیارا، مثل https://ai.liara.ir/api/<شناسه>/v1
# بدون این دو متغیر لایهٔ هوش کاملاً خاموش است و محصول مثل همیشه کار می‌کند.
LIARA_BASE_URL=

# Server-side secret: کلید API لیارا برای لایهٔ هوش (embedding، rerank، قضاوت نوع‌دار، گفتار به متن)؛ هرگز به مرورگر نمی‌رود
LIARA_API_KEY=

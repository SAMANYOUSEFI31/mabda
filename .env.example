# Optional: دسترسی به ابزارها و گزارش‌های سطح مدیر
MABDA_ADMIN=

# Optional feature flag: فعال‌سازی هوش مصنوعی مدیریت‌شده پلتفرم (مقدار نمونه: false)
MABDA_MANAGED_AI=false

# Server-side secret: کلید Gemini API؛ فقط در صورت فعال‌بودن هوش مصنوعی مدیریت‌شده لازم است
GEMINI_API_KEY=

# Optional: مسیر سفارشی فایل دیتابیس SQLite
MABDA_DB_PATH=

# Optional (لایهٔ هوش): نشانی سرویس لیارا، مثل https://ai.liara.ir/api/<شناسه>/v1
# بدون این دو متغیر لایهٔ هوش کاملاً خاموش است و محصول مثل همیشه کار می‌کند.
LIARA_BASE_URL=

# Server-side secret: کلید API لیارا برای لایهٔ هوش (embedding، rerank، قضاوت نوع‌دار، گفتار به متن)؛ هرگز به مرورگر نمی‌رود
LIARA_API_KEY=

# Online copy (sign-in): کلید ورود صاحب محصول، دست‌کم ۲۰ نویسه. با بودنش هر نفر با لینک شخصی خودش وارد می‌شود
# و دادهٔ جدا دارد. production بدون آن بالا نمی‌آید. صاحب محصول با https://<نشانی>/#join=<همین کلید> وارد می‌شود.
MABDA_OWNER_CODE=

# Optional: نشانی‌ای که افراد باز می‌کنند (مثل https://mabda.onrender.com)؛ برای لینک‌های دعوت و بررسی Origin
MABDA_PUBLIC_URL=

# Optional: پوشهٔ پشتیبان‌های روزانهٔ کل داده (۱۴ روز آخر)؛ پیش‌فرض: کنار فایل دیتابیس، پوشهٔ backups
MABDA_BACKUP_DIR=

# Optional, one-time: نام یک فایل پشتیبان (از پوشهٔ پشتیبان‌ها) برای برگرداندن کل داده در راه‌اندازی بعدی؛ docs/deploy.md
MABDA_RESTORE_FROM=
